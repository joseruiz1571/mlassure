node_modules/
dist/
.env
.env.local
*.local
bun.lockb
.DS_Store

# Custody chain (M3g): never commit key material or bundle output
*.key
cosign.key
out/
bundles/

# Conformance vectors (M6) are committed fixtures, not run output — re-include
# them below the bundles/ rule, and the one deliberate .DS_Store in the
# extra-file negative vector (git cannot re-include a file whose parent dir
# is excluded, so the directory negation must come first).
!fixtures/bundles/
!fixtures/bundles/negative/extra-file/.DS_Store
