# Required for the agent loop (M1+)
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-sonnet-4-6)
# MLASSURE_MODEL=claude-sonnet-4-6

# Required only for identity-linked / multi-workspace API keys.
# Single-workspace keys can omit this. Console: Settings → Workspaces.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
